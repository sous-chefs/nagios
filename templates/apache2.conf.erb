# Autogenerated by Chef.

<% unless @settings['ldap_verify_cert'].nil? %>LDAPVerifyServerCert <%= @settings['ldap_verify_cert'] %><% end %>
<% unless @settings['ldap_trusted_mode'].nil? -%>LDAPTrustedMode <%= @settings['ldap_trusted_mode'] %> <% end -%>
<% unless @settings['ldap_trusted_global_cert'].nil? -%>LDAPTrustedGlobalCert <%= @settings['ldap_trusted_global_cert'] %> <% end -%>

<VirtualHost *:<%= @settings['http_port'] %>>
  ServerAdmin     <%= @settings['sysadmin_email'] %>
<% if @nagios_url %>
  ServerName <%= @nagios_url %>
<% else %>
  ServerName      <%= node['fqdn'] %>
<% if @settings['server']['server_alias'] %>
  ServerAlias     <%= @settings['server']['server_alias'] %>
<% end %>
<% end %>
  DocumentRoot    <%= @settings['docroot'] %>
  CustomLog       <%= @apache_log_dir %>/nagios_access.log combined
  ErrorLog        <%= @apache_log_dir %>/nagios_error.log

<% if node['platform_family'] == 'debian' && @settings['server']['install_method'] == 'package'-%>
  Alias /stylesheets /etc/<%= @settings['server']['vname'] %>/stylesheets
  Alias /<%= @settings['server']['vname'] %>/stylesheets /etc/<%= @settings['server']['vname'] %>/stylesheets
<% end -%>
  ScriptAlias <%= @settings['cgi-path'] %> <%= @settings['cgi-bin'] %>
  ScriptAlias /cgi-bin/statusjson.cgi <%= @settings['cgi-bin'] %>/statusjson.cgi
  Alias /<%= @settings['server']['vname'] %> <%= @settings['docroot'] %>

  <Directory "<%= @settings['cgi-bin'] %>">
     Options ExecCGI FollowSymLinks
     <% if @settings['default_user_name'] -%>
     require all granted
     <% end -%>
  </Directory>

  <FilesMatch ".+\.ph(p[345]?|t|tml)$">
     SetHandler "<%= @apache_php_handler %>"
  </FilesMatch>

<% if @https -%>
  SSLEngine On
  SSLProtocol <%= @settings['ssl_protocols'] %>
<% if @settings['ssl_ciphers'] != nil -%>
  SSLCipherSuite <%= @settings['ssl_ciphers'] %>
<% end -%>
  SSLCertificateFile <%= @ssl_cert_file %>
<% if @settings['ssl_cert_chain_file'] %>
  SSLCertificateChainFile <%= @settings['ssl_cert_chain_file'] %>
<% end -%>
  SSLCertificateKeyFile <%= @ssl_cert_key %>

<% end -%>
<% case @settings['server_auth_method'] -%>
<% when "openid" -%>
  <Location />
    AuthName "Nagios Server"
    AuthType OpenID
    require user <%= node['apache']['allowed_openids'].join(' ') %>
    AuthOpenIDDBLocation <%= node['apache']['mod_auth_openid']['dblocation'] %>
  </Location>
<% when "cas" -%>
  CASLoginURL <%= @settings['cas_login_url'] %>
  CASValidateURL <%= @settings['cas_validate_url'] %>
  CASValidateServer <%= @settings['cas_validate_server'] %>
  <% if @settings['cas_root_proxy_url'] -%>
  CASRootProxiedAs <%= @settings['cas_root_proxy_url'] %>
  <% end -%>

  <Location />
    AuthType CAS
    require <%= @settings['server_auth_require'] %>
  </Location>
<% when "ldap" -%>
  <Location />
    AuthName "Nagios Server"
    AuthType Basic
    AuthBasicProvider ldap
    <% unless @settings['ldap_group_attribute_is_dn'].nil? %>AuthLDAPGroupAttributeIsDN <%= @settings['ldap_group_attribute_is_dn'] %><% end %>
    <% unless @settings['ldap_group_attribute'].nil? -%>AuthLDAPGroupAttribute "<%= @settings['ldap_group_attribute'] %>" <% end -%>
    <% unless @settings['ldap_bind_dn'].nil? -%>AuthLDAPBindDN "<%= @settings['ldap_bind_dn'] %>" <% end -%>
    <% unless @settings['ldap_bind_password'].nil? -%>AuthLDAPBindPassword "<%= @settings['ldap_bind_password'] %>"<% end -%>
    AuthLDAPURL "<%= @settings['ldap_url'] %>"
    require <%= @settings['server_auth_require'] %>
  </Location>
<% else -%>
  <Location />
    AuthName "Nagios Server"
    AuthType Basic
    AuthUserFile "<%= @settings['conf_dir'] %>/htpasswd.users"
    require <%= @settings['server_auth_require'] %>
    <% unless @settings['allowed_ips'].empty? -%>
    Order Deny,Allow
    Deny from All
    Allow from <%= @settings['allowed_ips'].join(' ') %>
    Satisfy Any
    <% end -%>
  </Location>
<% end -%>

  SetEnv TZ "<%= @settings['conf']['use_timezone'] %>"

</VirtualHost>
